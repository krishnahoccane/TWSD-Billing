# ---------------------------------------------------------------------------
# Template for .env. The web installer (/install) fills in the application,
# database, Redis, mail and key values and writes .env from this file, so the
# defaults below are production defaults. For local development set
# APP_ENV=local, APP_DEBUG=true, LOG_LEVEL=debug, SESSION_SECURE_COOKIE=false.
# Never put real secrets in this file — it is committed.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="Workspace Control Center"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://billing.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN
# Times are SHOWN in this zone; the database always stores UTC.
APP_TIMEZONE=Asia/Kolkata

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database — MySQL 8 or MariaDB 10.6+ (DB_CONNECTION=mysql | mariadb).
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=workspace_control_center
DB_USERNAME=wcc
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Sessions, cache and queue — Redis in production.
# For local development without Redis use: SESSION_DRIVER=database,
# CACHE_STORE=database, QUEUE_CONNECTION=database.
# ---------------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Must be true in production (HTTPS only).
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ---------------------------------------------------------------------------
# Mail — SMTP in production. MAIL_SCHEME=smtps for port 465, smtp for 587 (STARTTLS).
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Privileged users (platform roles) must enrol in TOTP 2FA. Keep true in production.
WCC_ENFORCE_2FA=true
# API token lifetime in minutes.
WCC_API_TOKEN_TTL=480

# ---------------------------------------------------------------------------
# Google Workspace (Admin SDK Directory API)
# When GOOGLE_WORKSPACE_ENABLED=false the application uses MockWorkspaceProvider
# and makes no calls to Google.
# ---------------------------------------------------------------------------
GOOGLE_WORKSPACE_ENABLED=false
GOOGLE_CLOUD_PROJECT_ID=
# Absolute path to the service-account key file, outside the web root. Never commit it.
# Absolute path, e.g. /home/<cpanel-user>/etc/billing.twsd.me/google/service-account.json (a relative path is taken from the application folder)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_ADMIN_EMAIL=
GOOGLE_CUSTOMER_ID=my_customer
GOOGLE_WORKSPACE_DELEGATION_ENABLED=false

# ---------------------------------------------------------------------------
# Zoho Books — use the endpoints of the data centre the account lives in.
#   India:  https://accounts.zoho.in   https://www.zohoapis.in/books/v3
#   US:     https://accounts.zoho.com  https://www.zohoapis.com/books/v3
#   EU:     https://accounts.zoho.eu   https://www.zohoapis.eu/books/v3
# ---------------------------------------------------------------------------
ZOHO_ENABLED=false
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI="${APP_URL}/integrations/zoho/callback"
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.in
ZOHO_API_BASE_URL=https://www.zohoapis.in/books/v3
ZOHO_ORGANISATION_ID=
# Webhook secret: 12-50 letters/digits. Set the same value as the Zoho webhook's secret
# token, or send it in a custom header X-WCC-Webhook-Token.
ZOHO_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Billing
# ---------------------------------------------------------------------------
BILLING_CURRENCY=INR
BILLING_TIMEZONE=Asia/Kolkata
BILLING_DEFAULT_CYCLE=monthly
BILLING_DEFAULT_DUE_DAYS=15
# GST rate. Same-state customers pay CGST + SGST (half each), others IGST, rounded per line like Zoho Books.
BILLING_DEFAULT_TAX_RATE=18.00
# First two digits of YOUR GSTIN (e.g. 36 = Telangana). Unset = every customer treated as same state.
BILLING_SUPPLIER_STATE_CODE=
# Differences from Zoho's total up to this many paise are rounding (written off once Zoho shows the invoice paid).
BILLING_ROUNDING_TOLERANCE_PAISE=100
# Reminders 2/1 days before the due date, on it, and 1/2 days after. Then every active mailbox of the
# organisation is suspended; paying reactivates exactly those mailboxes.
BILLING_AUTO_SUSPEND=true
BILLING_SUSPEND_AFTER_DAYS=2

# WhatsApp notifier. The app key and auth key are entered under Integrations -> WhatsApp (stored encrypted),
# never here. Real messages are sent in production (or locally with WHATSAPP_ENABLED=true).
WHATSAPP_ENABLED=false
WHATSAPP_ENDPOINT=https://api.whatsapp.webglit.com/api/create-message
WHATSAPP_DEFAULT_COUNTRY_CODE=91

VITE_APP_NAME="${APP_NAME}"

# Two-person rule for permanent mailbox deletion. Keep true in production.
GOOGLE_REQUIRE_SECOND_APPROVER=true
# Two-person rule for domain removal. Keep true in production.
DOMAIN_REQUIRE_SECOND_APPROVER=true

# Billing engine
BILLING_PRORATION_POLICY=prorate_daily
# {YY}/{YYYY} = year of issue, {SEQ} = running number restarting each year (26/TWSD-001)
BILLING_INVOICE_NUMBER_FORMAT="{YY}/TWSD-{SEQ}"
BILLING_INVOICE_NUMBER_PADDING=3
BILLING_CREDIT_NOTE_PREFIX=CN-
# Super Admins may record verified offline payments (bank transfers).
BILLING_ALLOW_MANUAL_PAYMENTS=true
